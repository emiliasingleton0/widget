{
  "name": "mochi-desk-buddy",
  "version": "2.0.0",
  "description": "A transparent desktop companion with focus, tasks, and notes.",
  "main": "src/main/index.cjs",
  "author": "Emi",
  "license": "MIT",
  "private": false,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "check": "node scripts/check-project.cjs",
    "test": "node --test tests/*.test.cjs",
    "build:portable": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis",
    "build": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "37.2.3",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "dev.mochi.deskbuddy",
    "productName": "Mochi Desk Buddy",
    "asar": true,
    "files": ["src/**/*", "README.md", "LICENSE"],
    "directories": {"output": "dist"},
    "win": {
      "target": [
        {"target": "nsis", "arch": ["x64"]},
        {"target": "portable", "arch": ["x64"]}
      ],
      "artifactName": "Mochi-Desk-Buddy-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mochi Desk Buddy",
      "artifactName": "Mochi-Desk-Buddy-Setup-${version}-${arch}.${ext}"
    }
  }
}
