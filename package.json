{
  "name": "mochi-desk-buddy",
  "version": "1.0.0",
  "description": "A kawaii draggable desktop productivity widget built with Electron.",
  "main": "main.js",
  "author": "Emi",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:win": "electron-builder --win portable",
    "build:mac": "electron-builder --mac dmg",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.emi.mochideskbuddy",
    "productName": "Mochi Desk Buddy",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "script.js",
      "assets/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    }
  }
}
